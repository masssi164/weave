{
  "schemaVersion": "weave.member-client-scenario/v1",
  "scenarioId": "member-client-baseline",
  "version": 1,
  "requiredDomains": ["chat", "files", "calendar"],
  "sharedSpace": {
    "logicalId": "shared-space",
    "spaceRef": "workspace-default"
  },
  "actors": [
    {
      "slot": "A",
      "logicalId": "member-a",
      "organizationRole": "member",
      "spacePermissions": ["VIEW", "EDIT"]
    },
    {
      "slot": "B",
      "logicalId": "member-b",
      "organizationRole": "member",
      "spacePermissions": ["VIEW", "EDIT"]
    }
  ],
  "content": {
    "conversation": "Weave UI {runId}",
    "messageA": "A UI {runId}",
    "messageB": "B UI {runId}",
    "event": "Calendar UI {runId}",
    "updatedEvent": "Calendar UI {runId} updated",
    "folder": "weave-smoke-{runId}",
    "privateFolder": "weave-smoke-private-{runId}",
    "initialFileName": "weave-dual-initial-{runId}.txt",
    "replacementFileName": "weave-dual-replacement-{runId}.txt",
    "initialContent": "Weave actual UI initial {runId}\n",
    "replacementContent": "Weave actual UI replacement {runId}\n"
  }
}
