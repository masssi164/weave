  "ports": [
    {
      "name": "SourceControlProvider",
      "read_operations": [
        "listLinkedProjects",
        "getRepositorySummary",
        "listBranches",
        "listTags",
        "listRecentCommits",
        "getFileMetadata"
      ],
      "write_operations_later": [
        "createBranch",
        "createCommitOrFileChange",
        "openMergeOrPullRequest"
      ]
    },
    {
      "name": "IssueTrackerProvider",
      "read_operations": [
        "listOpenIssues",
        "getIssue",
        "listIssueComments",
        "listLabels",
        "listMilestones"
      ],
      "write_operations_later": [
        "createIssueComment",
        "setIssueLabels",
        "updateIssueState"
      ]
    },
    {
      "name": "CiProvider",
      "read_operations": [
        "listPipelinesOrRuns",
        "getPipelineOrRun",
        "listJobs",
        "getJobLogMetadata",
        "listArtifactsMetadata"
      ],
      "write_operations_later": [
        "retryJob",
        "cancelPipelineOrRun",
        "triggerPipelineOrWorkflow"
      ]
    },
    {
      "name": "ReleaseProvider",
      "read_operations": [
        "listReleases",
        "getRelease",
        "listTags",
        "listPackages",
        "listContainerImages"
      ],
      "write_operations_later": [
        "createReleaseDraftOrRelease",
        "attachReleaseAsset"
      ]
    }
  ],
  "required_capability_keys": [
    "license_and_self_hosting",
