  "backend_facade_required": true,
  "flutter_provider_neutral": true,
  "no_provider_tokens_to_flutter": true,
  "no_raw_provider_errors_to_flutter": true,
  "allowed_error_codes": [
    "unauthorized",
    "forbidden",
    "not_found",
    "conflict",
    "rate_limited",
    "offline",
    "validation",
    "provider_unavailable",
    "provider_feature_unavailable",
    "unknown"
