{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weave.test/contracts/portability/archive-manifest.schema.json",
  "title": "ArchiveManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestId",
    "domainKey",
    "archiveRefs",
    "retentionUntil",
    "contentHashes",
    "redaction"
  ],
  "properties": {
    "manifestId": {
      "type": "string"
    },
    "domainKey": {
      "type": "string"
    },
    "archiveRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "retentionUntil": {
      "type": "string"
    },
    "contentHashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "redaction": {
      "type": "string",
      "enum": [
        "support_safe"
      ]
    }
  }
}
