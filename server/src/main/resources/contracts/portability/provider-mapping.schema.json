{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weave.local/contracts/portability/provider-mapping.schema.json",
  "title": "ProviderMapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["mappingId", "domainKey", "sourceProvider", "targetProvider", "objectMappings", "redaction"],
  "properties": {
    "mappingId": {"type": "string"},
    "domainKey": {"type": "string"},
    "sourceProvider": {"type": "string"},
    "targetProvider": {"type": "string"},
    "objectMappings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["canonicalObject", "sourceRef", "targetRef", "lossClass"], "properties": {"canonicalObject": {"type": "string"}, "sourceRef": {"type": "string"}, "targetRef": {"type": "string"}, "lossClass": {"$ref": "loss-class.schema.json"}}}},
    "redaction": {"type": "string", "enum": ["support_safe"]}
  }
}
