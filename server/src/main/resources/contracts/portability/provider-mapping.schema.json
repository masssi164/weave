{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weave.test/contracts/portability/provider-mapping.schema.json",
  "title": "ProviderMapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mappingId",
    "domainKey",
    "sourceProvider",
    "targetProvider",
    "objectMappings",
    "redaction"
  ],
  "properties": {
    "mappingId": {
      "type": "string"
    },
    "domainKey": {
      "type": "string"
    },
    "sourceProvider": {
      "type": "string"
    },
    "targetProvider": {
      "type": "string"
    },
    "objectMappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "canonicalObject",
          "sourceRef",
          "targetRef",
          "lossClass",
          "fieldClass"
        ],
        "properties": {
          "canonicalObject": {
            "type": "string"
          },
          "sourceRef": {
            "type": "string"
          },
          "targetRef": {
            "type": "string"
          },
          "lossClass": {
            "$ref": "loss-class.schema.json",
            "description": "Deprecated alias retained only for v1 fixture compatibility; v2 consumers must use fieldClass."
          },
          "fieldClass": {
            "$ref": "loss-class.schema.json"
          }
        }
      }
    },
    "redaction": {
      "type": "string",
      "enum": [
        "support_safe"
      ]
    }
  }
}
