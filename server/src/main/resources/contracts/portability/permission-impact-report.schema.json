{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weave.local/contracts/portability/permission-impact-report.schema.json",
  "title": "PermissionImpactReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportId",
    "domainKey",
    "impacts",
    "approvalRequired",
    "redaction"
  ],
  "properties": {
    "reportId": {
      "type": "string"
    },
    "domainKey": {
      "type": "string"
    },
    "impacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "canonicalObject",
          "impact",
          "fieldClass"
        ],
        "properties": {
          "canonicalObject": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "fieldClass": {
            "$ref": "loss-class.schema.json"
          }
        }
      }
    },
    "approvalRequired": {
      "type": "boolean"
    },
    "redaction": {
      "type": "string",
      "enum": [
        "support_safe"
      ]
    }
  }
}
