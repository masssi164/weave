{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weave.test/contracts/portability/provider-adapter-manifest.schema.json",
  "title": "ProviderAdapterManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapterKey",
    "domainKeys",
    "apiProfile",
    "canonicalObjects",
    "capabilityKeys",
    "readinessChecks",
    "unsupportedFields",
    "migrationLimits",
    "auditEvents",
    "secretBoundary",
    "supportSafeEvidenceRedaction",
    "realityLevelByDomain",
    "historyPosture",
    "riskNotes",
    "secretStoragePosture",
    "adapterMapperKey",
    "activeBindingStatus",
    "provenanceReportRef",
    "lossReportRef",
    "permissionImpactReportRef",
    "conflictReportRef",
    "portabilityManifestRef",
    "auditRef"
  ],
  "properties": {
    "adapterKey": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "domainKeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "apiProfile": {
      "type": "string"
    },
    "canonicalObjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "capabilityKeys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "readinessChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "unsupportedFields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "migrationLimits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "auditEvents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "secretBoundary": {
      "type": "string",
      "enum": [
        "no_secrets",
        "server_only",
        "operator_vault_only"
      ]
    },
    "supportSafeEvidenceRedaction": {
      "type": "string",
      "enum": [
        "support_safe"
      ]
    },
    "realityLevelByDomain": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "enum": [
          "contract_only",
          "configured",
          "live_read",
          "live_write",
          "migration_dry_run",
          "migration_apply_ready",
          "rollback_ready",
          "release_ready"
        ]
      }
    },
    "historyPosture": {
      "type": "string",
      "enum": [
        "unknown",
        "no_history",
        "partial_history",
        "history_export_supported",
        "history_import_supported",
        "history_preserved_with_receipts"
      ]
    },
    "riskNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "secretStoragePosture": {
      "type": "string",
      "enum": [
        "no_secrets",
        "server_secret_ref_only",
        "operator_vault_ref_only"
      ]
    },
    "adapterMapperKey": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "activeBindingStatus": {
      "type": "string",
      "enum": [
        "active",
        "candidate",
        "discovery_read_only",
        "migration_source",
        "migration_target",
        "coexistence_preflight",
        "deprecated",
        "superseded"
      ]
    },
    "provenanceReportRef": {
      "type": "string",
      "minLength": 1
    },
    "lossReportRef": {
      "type": "string",
      "minLength": 1
    },
    "permissionImpactReportRef": {
      "type": "string",
      "minLength": 1
    },
    "conflictReportRef": {
      "type": "string",
      "minLength": 1
    },
    "portabilityManifestRef": {
      "type": "string",
      "minLength": 1
    },
    "auditRef": {
      "type": "string",
      "minLength": 1
    }
  }
}
