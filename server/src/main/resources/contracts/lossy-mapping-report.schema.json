{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weave.local/contracts/lossy-mapping-report.schema.json",
  "title": "Weave Lossy Mapping Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "domain",
    "run_id",
    "entries",
    "summary_counts",
    "support_safe_diagnostics"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "enum": [
        "identity",
        "people",
        "spaces",
        "chat",
        "files",
        "documents",
        "calendar",
        "boards",
        "calls",
        "decisions",
        "notifications",
        "health",
        "weaver"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_object",
          "field",
          "loss_class",
          "explanation"
        ],
        "properties": {
          "canonical_object": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "loss_class": {
            "$ref": "#/$defs/loss_class"
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "provider_mapping_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "support_safe_diagnostics": {
      "$ref": "#/$defs/redaction"
    }
  },
  "$defs": {
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_safe",
        "secrets_returned",
        "raw_provider_payloads_returned",
        "raw_provider_errors_returned"
      ],
      "properties": {
        "support_safe": {
          "type": "boolean",
          "const": true
        },
        "secrets_returned": {
          "type": "boolean",
          "const": false
        },
        "raw_provider_payloads_returned": {
          "type": "boolean",
          "const": false
        },
        "raw_provider_errors_returned": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "loss_class": {
      "type": "string",
      "enum": [
        "lossless_canonical",
        "lossless_extension",
        "archive_only",
        "lossy_with_report",
        "blocked_nonportable",
        "provider_unexportable"
      ]
    }
  }
}
