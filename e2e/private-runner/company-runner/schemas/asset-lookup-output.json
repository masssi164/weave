{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:weave:e2e:internal-asset-lookup-output:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assetId",
    "kind",
    "status",
    "displayName"
  ],
  "properties": {
    "assetId": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "status": {
      "enum": [
        "available",
        "degraded",
        "unavailable"
      ]
    },
    "displayName": {
      "type": "string"
    },
    "relatedServices": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string"
      }
    }
  }
}
