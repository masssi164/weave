{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:weave:runner:capability-bundle:v1",
  "title": "Weave Runner capability bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleId", "bundleVersion", "capabilities"],
  "properties": {
    "schemaVersion": {"const": "weave.runner.capability-bundle/v1"},
    "bundleId": {"$ref": "#/$defs/identifier"},
    "bundleVersion": {"$ref": "#/$defs/semanticVersion"},
    "displayName": {"type": "string", "minLength": 1, "maxLength": 160},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/capability"}
    },
    "detectors": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/detector"},
      "default": []
    },
    "labels": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {"type": "string", "maxLength": 256},
      "default": {}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "maxLength": 96
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\r\\n]+$",
      "maxLength": 1024
    },
    "environmentName": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]*$",
      "maxLength": 128
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "handler", "inputSchema", "outputSchema", "effect"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/semanticVersion"},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "description": {"type": "string", "maxLength": 1000},
        "handler": {"$ref": "#/$defs/absolutePath"},
        "workingDirectory": {"$ref": "#/$defs/absolutePath"},
        "inputSchema": {"$ref": "#/$defs/absolutePath"},
        "outputSchema": {"$ref": "#/$defs/absolutePath"},
        "effect": {"enum": ["READ_ONLY", "IDEMPOTENT_WRITE", "NON_IDEMPOTENT_WRITE"]},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600, "default": 300},
        "maxOutputBytes": {"type": "integer", "minimum": 1024, "maximum": 16777216, "default": 1048576},
        "environmentAllowlist": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/environmentName"},
          "default": []
        },
        "networkProfile": {"$ref": "#/$defs/identifier"},
        "artifactTypes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160},
          "default": []
        }
      }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "handler", "sourceKind"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/semanticVersion"},
        "handler": {"$ref": "#/$defs/absolutePath"},
        "workingDirectory": {"$ref": "#/$defs/absolutePath"},
        "sourceKind": {"enum": ["DECLARATION", "OPENAPI", "ASYNCAPI", "SBOM", "OTEL", "RUNTIME", "CUSTOM"]},
        "intervalSeconds": {"type": "integer", "minimum": 30, "maximum": 86400, "default": 300},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 900, "default": 60},
        "environmentAllowlist": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/environmentName"},
          "default": []
        }
      }
    }
  }
}
