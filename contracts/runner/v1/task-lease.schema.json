{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:weave:runner:task-lease:v1",
  "title": "Weave Runner task lease v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "leaseId", "fencingToken", "runnerId", "capability", "bundleDigest", "attempt", "idempotencyKey", "payload", "resourceGrants", "issuedAt", "expiresAt"],
  "properties": {
    "schemaVersion": {"const": "weave.runner.task-lease/v1"},
    "taskId": {"type": "string", "format": "uuid"},
    "leaseId": {"type": "string", "format": "uuid"},
    "fencingToken": {"type": "integer", "minimum": 1},
    "runnerId": {"type": "string", "pattern": "^runner_[A-Za-z0-9_-]{8,128}$"},
    "capability": {"$ref": "#/$defs/capabilityReference"},
    "bundleDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 100},
    "idempotencyKey": {"type": "string", "minLength": 16, "maxLength": 256},
    "payload": {},
    "contextRefs": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^weave://(space|resource|artifact|task)/[^\\s]+$", "maxLength": 1024},
      "default": []
    },
    "resourceGrants": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/resourceGrant"}},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "deadline": {"type": "string", "format": "date-time"},
    "traceparent": {"type": "string", "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"}
  },
  "$defs": {
    "capabilityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 128},
        "version": {"type": "string", "maxLength": 96}
      }
    },
    "resourceGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "operations"],
      "properties": {
        "resourceId": {"type": "string", "pattern": "^weave://resource/[^\\s]+$", "maxLength": 1024},
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 128}
        },
        "expectedVersion": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
