{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:weave:runner:public-capability-bundle:v1",
  "title": "Weave Runner public capability bundle v1",
  "description": "Sanitized capability contracts published to the Engine. Local handlers, arguments, environment names, internal endpoints and credentials are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleId", "bundleVersion", "bundleDigest", "capabilities"],
  "properties": {
    "schemaVersion": {"const": "weave.runner.public-capability-bundle/v1"},
    "bundleId": {"$ref": "#/$defs/identifier"},
    "bundleVersion": {"$ref": "#/$defs/semanticVersion"},
    "bundleDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "maxLength": 96
    },
    "jsonSchema": {
      "type": ["object", "boolean"]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "description",
        "effect",
        "inputSchema",
        "inputSchemaDigest",
        "outputSchema",
        "outputSchemaDigest",
        "timeoutSeconds",
        "maxOutputBytes",
        "artifactTypes"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/semanticVersion"},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "description": {"type": "string", "maxLength": 1000},
        "effect": {"enum": ["READ_ONLY", "IDEMPOTENT_WRITE", "NON_IDEMPOTENT_WRITE"]},
        "inputSchema": {"$ref": "#/$defs/jsonSchema"},
        "inputSchemaDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "outputSchema": {"$ref": "#/$defs/jsonSchema"},
        "outputSchemaDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "maxOutputBytes": {"type": "integer", "minimum": 1024, "maximum": 16777216},
        "artifactTypes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      }
    }
  }
}
