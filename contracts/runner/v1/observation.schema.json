{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:weave:runner:observation:v1",
  "title": "Weave Runner topology observation batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runnerId", "detectorId", "detectorVersion", "sourceKind", "observedAt", "ttlSeconds", "entities", "relations"],
  "properties": {
    "schemaVersion": {"const": "weave.runner.observation/v1"},
    "runnerId": {"type": "string", "pattern": "^runner_[A-Za-z0-9_-]{8,128}$"},
    "detectorId": {"$ref": "#/$defs/identifier"},
    "detectorVersion": {"type": "string", "minLength": 1, "maxLength": 96},
    "sourceKind": {"enum": ["DECLARATION", "OPENAPI", "ASYNCAPI", "SBOM", "OTEL", "RUNTIME", "CUSTOM"]},
    "scope": {"type": "string", "maxLength": 256},
    "observedAt": {"type": "string", "format": "date-time"},
    "ttlSeconds": {"type": "integer", "minimum": 30, "maximum": 2592000},
    "entities": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/entity"}},
    "relations": {"type": "array", "maxItems": 8192, "items": {"$ref": "#/$defs/relation"}},
    "batchDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "traceparent": {"type": "string", "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "minLength": 1, "maxLength": 128},
    "localKey": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000\\r\\n]+$"},
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localKey", "kind"],
      "properties": {
        "localKey": {"$ref": "#/$defs/localKey"},
        "kind": {"$ref": "#/$defs/identifier"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 256},
        "aliases": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}, "default": []},
        "attributes": {"type": "object", "maxProperties": 64, "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}, "default": {}},
        "evidence": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/evidence"}, "default": []}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromLocalKey", "predicate", "toLocalKey", "confidence"],
      "properties": {
        "fromLocalKey": {"$ref": "#/$defs/localKey"},
        "predicate": {"$ref": "#/$defs/identifier"},
        "toLocalKey": {"$ref": "#/$defs/localKey"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "attributes": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}, "default": {}},
        "evidence": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/evidence"}, "default": []}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {"enum": ["DECLARATION", "DOCUMENT", "SCHEMA", "SBOM", "TRACE", "RUNTIME", "HASH", "CUSTOM"]},
        "reference": {"type": "string", "minLength": 1, "maxLength": 1024},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
