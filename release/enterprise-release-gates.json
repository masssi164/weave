{
  "schemaVersion": 1,
  "status": "enterprise-dogfood-human-testing-gate",
  "promotionModel": {
    "branching": "dev-to-dogfood-to-main",
    "releaseCandidateSource": "dogfood",
    "promotionRule": "no-main-promotion-until-the-exact-candidate-human-testing-readiness-manifest-is-ready",
    "mandatoryGateWaiversAllowed": false
  },
  "lanes": [
    {
      "id": "pr-safe-ci",
      "purpose": "fast deterministic monorepo confidence before merge",
      "trigger": "pull_request and push",
      "requiredFor": [
        "merge-readiness"
      ],
      "gates": [
        {
          "id": "gradle-ci",
          "command": "./gradlew ci",
          "required": true,
          "evidence": [
            "build/evidence/ci-summary.json",
            "build/docs"
          ]
        },
        {
          "id": "spec-corpus-conformance",
          "command": "./gradlew specCorpusConformance",
          "required": true,
          "evidence": [
            "specs/weave-specs.lock.json",
            "pinned-corpus-lint"
          ]
        },
        {
          "id": "release-notes-label-check",
          "command": "./gradlew releaseNotesLabelCheck",
          "required": true,
          "evidence": [
            "exactly-one-release-notes-label"
          ]
        }
      ]
    },
    {
      "id": "release-candidate-live-evidence",
      "purpose": "credential-free Fresh product flow on the dedicated disposable runner",
      "trigger": "dev-to-dogfood promotion pull request, exact dogfood push, or explicit isolated workflow dispatch",
      "requiredFor": [
        "v0.1-rc-promotion",
        "dogfood-production-tag"
      ],
      "gates": [
        {
          "id": "test-app-product-flow-e2e",
          "workflow": ".github/workflows/live-stack-e2e.yml",
          "required": true,
          "evidence": [
            "weave-live-stack-acceptance-evidence/weave-test-app-evidence.json"
          ],
          "mustObserveMarkers": [
            "WEAVE_TEST_APP_RESULT"
          ],
          "supportSafeExclusions": [
            "human credentials",
            "activation links",
            "OAuth tokens",
            "private keys",
            "provider internals",
            "private live logs"
          ],
          "mustObserveEvidenceFields": [
            "activation",
            "humanOAuth",
            "workloadOAuth",
            "mcpTool",
            "canonicalResourceSeen",
            "revocationDenied",
            "credentialsIncluded",
            "actionLinksIncluded",
            "supportSafe"
          ]
        }
      ]
    },
    {
      "id": "persistent-dogfood-verification",
      "purpose": "deploy the accepted candidate without mutating the single persistent human tester",
      "trigger": "candidate merged to dogfood after isolated collaboration succeeds",
      "requiredFor": [
        "ios-dogfood-distribution",
        "main-promotion"
      ],
      "gates": [
        {
          "id": "persistent-dogfood-deployment",
          "workflow": ".github/workflows/test-stack-deploy.yml",
          "required": true,
          "evidence": [
            "weave-test-stack-evidence/dogfood-deployment-evidence.json",
            "weave-test-stack-evidence/test-stack-manifest.json",
            "weave-test-stack-evidence/provider-health-summary.json"
          ]
        }
      ]
    },
    {
      "id": "ios-dogfood-distribution",
      "purpose": "build and upload only the exact successfully deployed dogfood candidate",
      "trigger": "successful Test Stack Deploy workflow_run for dogfood",
      "requiredFor": [
        "physical-human-acceptance",
        "main-promotion"
      ],
      "gates": [
        {
          "id": "ios-dogfood-distribution",
          "workflow": ".github/workflows/ios-dogfood.yml",
          "required": true,
          "evidence": [
            "ios-dogfood-distribution-<build>/ios-dogfood-distribution.json"
          ]
        }
      ]
    },
    {
      "id": "physical-human-acceptance",
      "purpose": "record in-place physical-iPhone VoiceOver and session acceptance for the exact candidate",
      "trigger": "protected manual dispatch after TestFlight distribution",
      "requiredFor": [
        "main-promotion",
        "human-testing-ready-claim"
      ],
      "gates": [
        {
          "id": "physical-iphone-voiceover",
          "workflow": ".github/workflows/human-testing-readiness.yml",
          "required": true,
          "evidence": [
            "human-testing-readiness-<commit>/human-testing-readiness.json"
          ]
        },
        {
          "id": "human-testing-readiness-manifest",
          "command": "python3 tools/human_testing_readiness_manifest.py validate --manifest human-testing-readiness.json --require-ready",
          "required": true,
          "evidence": [
            "human-testing-readiness.json"
          ]
        }
      ]
    },
    {
      "id": "release-promotion",
      "purpose": "reviewable release candidate decision and draft publication",
      "trigger": "release owner decision after the exact-candidate readiness manifest is ready",
      "requiredFor": [
        "release-draft",
        "tagging"
      ],
      "gates": [
        {
          "id": "release-draft-review",
          "workflow": ".github/workflows/release-draft.yml",
          "required": true,
          "evidence": [
            "release-draft-review-<tag>",
            "docs/release-notes/v0.1.md"
          ]
        },
        {
          "id": "release-owner-signoff",
          "required": true,
          "evidence": [
            "GitHub issue or release checklist naming commit, artifacts, blocker/waiver if any, rollback note, owner"
          ]
        }
      ]
    }
  ],
  "ownership": {
    "releaseOwner": "human release owner",
    "orchestration": "weave-co-leader coordinates specialist agents; main session verifies gates and reports",
    "secrets": "GitHub environment/repository secrets and SecretRef-style runtime configuration only",
    "logs": "support-safe summaries by default; raw provider logs stay private runner/operator diagnostics"
  }
}
