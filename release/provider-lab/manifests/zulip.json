{
  "schemaVersion": 1,
  "manifestKind": "weave-provider-lab-provider-manifest",
  "providerKey": "zulip",
  "displayName": "Zulip",
  "domain": "chat",
  "realityLevel": "configured",
  "capabilityFlags": [
    "chat.read",
    "chat.send",
    "threads",
    "reactions",
    "attachments.metadata"
  ],
  "historyHonesty": {
    "preservationClaim": "fixture_expected_statuses_only",
    "statuses": [
      "preserved",
      "partially_preserved",
      "archive_only",
      "unsupported",
      "unexportable",
      "conflict",
      "metadata_only"
    ],
    "fullHistoryPreserved": false,
    "notes": "Stream/topic semantics can be lossy when mapped to Weave threads; no migration apply claim."
  },
  "rollback": {
    "claim": "not_ready",
    "rollbackReady": false,
    "notes": "Rollback remains blocked until named migration apply and rollback evidence exists."
  },
  "migrationLimits": {
    "applyClaimed": false,
    "releaseReadyClaimed": false,
    "knownLossyFields": [
      "provider_specific_permissions",
      "provider_specific_history_metadata"
    ]
  },
  "secretStorage": {
    "source": "local_env_or_credential_broker_reference",
    "checkedInSecrets": false,
    "credentialBearingUrlsAllowedInEvidence": false
  },
  "supportEvidence": {
    "redacted": true,
    "allowedFields": [
      "providerKey",
      "domain",
      "realityLevel",
      "capabilityFlags",
      "historyHonesty.statuses",
      "rollback.claim",
      "checkedAt"
    ],
    "forbiddenFields": [
      "tokens",
      "passwords",
      "cookies",
      "privateUrls",
      "rawProviderPayloads",
      "rawProviderErrors"
    ]
  }
}
