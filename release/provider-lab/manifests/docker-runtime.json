{
  "schemaVersion": 1,
  "manifestKind": "weave-provider-lab-provider-manifest",
  "providerKey": "docker-runtime",
  "displayName": "Docker Runtime boundary",
  "domain": "weaver",
  "realityLevel": "configured",
