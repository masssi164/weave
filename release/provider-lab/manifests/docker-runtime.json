  "supportEvidence": {
    "redacted": true,
    "allowedFields": [
      "providerKey",
      "domain",
      "realityLevel",
      "capabilityFlags",
      "runtimeLifecycleFixture",
      "reconciliationFixture",
      "isolationFixture",
      "historyHonesty.statuses",
      "rollback.claim",
      "checkedAt"
    ],
    "forbiddenFields": [
