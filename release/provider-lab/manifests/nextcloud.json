{
  "schemaVersion": 1,
  "manifestKind": "weave-provider-lab-provider-manifest",
  "providerKey": "nextcloud",
  "displayName": "Nextcloud",
  "domain": "files",
  "realityLevel": "configured",
  "capabilityFlags": [
    "files.read",
    "files.write",
    "webdav",
    "caldav"
  ],
  "historyHonesty": {
    "preservationClaim": "fixture_expected_statuses_only",
    "statuses": [
      "preserved",
      "partially_preserved",
      "archive_only",
      "unsupported",
      "unexportable",
      "conflict",
      "metadata_only"
    ],
    "fullHistoryPreserved": false,
    "notes": "Sprint 22 proves configured lab and fixture/manifest shape only, not provider interchangeability."
  },
  "rollback": {
    "claim": "not_ready",
    "rollbackReady": false,
    "notes": "Rollback remains blocked until named migration apply and rollback evidence exists."
  },
  "migrationLimits": {
    "applyClaimed": false,
    "releaseReadyClaimed": false,
    "knownLossyFields": [
      "provider_specific_permissions",
      "provider_specific_history_metadata"
    ]
  },
  "secretStorage": {
    "source": "local_env_or_credential_broker_reference",
    "checkedInSecrets": false,
    "credentialBearingUrlsAllowedInEvidence": false
  },
  "supportEvidence": {
    "redacted": true,
    "allowedFields": [
      "providerKey",
      "domain",
      "realityLevel",
      "capabilityFlags",
      "historyHonesty.statuses",
      "rollback.claim",
      "checkedAt"
    ],
    "forbiddenFields": [
      "tokens",
      "passwords",
      "cookies",
      "privateUrls",
      "rawProviderPayloads",
      "rawProviderErrors"
    ]
  }
}
