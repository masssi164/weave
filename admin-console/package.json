{
  "name": "@weave/admin-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --environment jsdom",
    "ci": "npm run build && npm run test",
    "generate:openapi": "cd .. && ./gradlew generateOpenApiContract generateAdminOpenApiTypes",
    "check:openapi": "cd .. && ./gradlew checkOpenApiContractFresh checkAdminOpenApiTypesFresh"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.0.1",
    "@mui/material": "9.0.1",
    "@vitejs/plugin-react": "6.0.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite": "8.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
