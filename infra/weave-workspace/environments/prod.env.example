# Release-capable single-host input template. Publication still requires the
# protected production approval. Every image is digest-pinned; every credential
# is a separately governed mounted secret file.
WEAVE_ENVIRONMENT=prod
COMPOSE_PROFILES=prod
WEAVE_DEPLOYMENT_CONTEXT=production
WEAVE_DEPLOYMENT_SCOPE=production
WEAVE_DEPLOYMENT_INSTANCE=prod-primary
WEAVE_COMPOSE_PROJECT=weave-prod
WEAVE_RESOURCE_PREFIX=weave
WEAVE_STACK_SCOPE=persistent
WEAVE_RUNTIME_UID=65532
WEAVE_RUNTIME_GID=65532
WEAVE_DOCKER_NETWORK=weave_prod_network
WEAVE_CADDY_DATA_VOLUME=weave_prod_caddy_data
WEAVE_CADDY_CONFIG_VOLUME=weave_prod_caddy_config
WEAVE_DB_DATA_VOLUME=weave_prod_db_data
WEAVE_KEYCLOAK_DATA_VOLUME=weave_prod_keycloak_data
WEAVE_MAILPIT_DATA_VOLUME=weave_prod_mailpit_data
WEAVE_NEXTCLOUD_DATA_VOLUME=weave_prod_nextcloud_data
WEAVE_SYNAPSE_DATA_VOLUME=weave_prod_synapse_data
WEAVE_MATRIX_APPSERVICE_VOLUME=weave_prod_matrix_chat_appservice_runtime
WEAVE_RUNTIME_STATE_VOLUME=weave_prod_runtime_state
WEAVE_NATIVE_FILES_DATA_VOLUME=weave_prod_native_files_data
WEAVE_GENERATED_ROOT=/opt/weave/generated/prod
WEAVE_SECRET_ROOT=/opt/weave/secrets/prod
WEAVE_TLS_ROOT=/opt/weave/tls
WEAVE_PROXY_HTTP_HOST_PORT=80
WEAVE_PROXY_HTTPS_HOST_PORT=443
WEAVE_KEYCLOAK_HOST_PORT=48080
WEAVE_KEYCLOAK_MANAGEMENT_HOST_PORT=49000
WEAVE_MAS_HOST_PORT=48082
WEAVE_SYNAPSE_HOST_PORT=48008
WEAVE_NEXTCLOUD_HOST_PORT=48083
WEAVE_BACKEND_HOST_PORT=48084
WEAVE_MCP_HOST_PORT=48085
WEAVE_TENANT_DOMAIN=weave.example
WEAVE_PUBLIC_URL=https://weave.example
WEAVE_API_ORIGIN=https://api.weave.example
WEAVE_API_URL=https://api.weave.example/api
WEAVE_AUTH_URL=https://auth.weave.example
WEAVE_MATRIX_URL=https://matrix.weave.example
WEAVE_FILES_URL=https://files.weave.example
WEAVE_FILES_PUBLIC_AUTHORITY=files.weave.example
WEAVE_SMTP_HOST=smtp.weave.example
WEAVE_SMTP_PORT=465
WEAVE_SMTP_USERNAME=replace-with-reviewed-smtp-user
WEAVE_SMTP_FROM_ADDRESS=noreply@weave.example
WEAVE_SMTP_FROM_DISPLAY_NAME=Weave
WEAVE_ORGANIZATION_NAME=Weave
WEAVE_ORGANIZATION_ALIAS=weave
WEAVE_ORGANIZATION_DESCRIPTION=Weave organization
WEAVE_POSTGRES_IMAGE=postgres@sha256:replace-with-approved-digest
WEAVE_CADDY_IMAGE=caddy@sha256:replace-with-approved-digest
WEAVE_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak@sha256:replace-with-approved-26.7.1-digest
WEAVE_MAS_IMAGE=ghcr.io/element-hq/matrix-authentication-service@sha256:replace-with-approved-digest
WEAVE_SYNAPSE_IMAGE=matrixdotorg/synapse@sha256:replace-with-approved-digest
WEAVE_NEXTCLOUD_IMAGE=nextcloud@sha256:replace-with-approved-digest
WEAVE_BACKEND_IMAGE=ghcr.io/masssi164/weave-backend@sha256:replace-with-candidate-digest
WEAVE_MCP_IMAGE=ghcr.io/masssi164/weave-mcp-server@sha256:replace-with-candidate-digest
