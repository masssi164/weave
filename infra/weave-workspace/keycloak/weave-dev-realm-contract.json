{
  "artifactVersion": "keycloak-realm-contract-v2",
  "realm": "weave",
  "issuer": "https://auth.weave.test/realms/weave",
  "recommendedIdentityBroker": "keycloak",
  "organizationClaims": {
    "tenantClaim": "weave_tenant_id",
    "displayNameClaim": "weave_organization_name",
    "defaultTenantId": "weave-dogfood",
    "defaultDisplayName": "Weave Dogfood"
  },
  "clients": [
    {
      "clientId": "weave-app",
      "accessType": "PUBLIC",
      "pkce": "S256",
      "defaultScopes": ["profile", "email", "roles", "weave:workspace"],
      "audience": "weave-app"
    },
    {
      "clientId": "weave-admin-console",
      "accessType": "PUBLIC",
      "pkce": "S256",
      "defaultScopes": ["profile", "email", "roles", "weave:workspace"],
      "redirectUris": ["https://admin.weave.test/*"],
      "audience": "weave-app"
    },
    {
      "clientId": "weave-backend",
      "accessType": "BEARER-ONLY"
    }
  ],
  "realmRoles": ["weaver-runtime"],
  "clientRoles": {
    "weave-app": ["owner", "admin", "member", "guest"]
  },
  "organizationGroups": [
    { "path": "/owners", "clientRoles": ["weave-app:owner"] },
    { "path": "/admins", "clientRoles": ["weave-app:admin"] },
    { "path": "/members", "clientRoles": ["weave-app:member"] },
    { "path": "/guests", "clientRoles": ["weave-app:guest"] },
    { "path": "/capabilities", "clientRoles": [] },
    {
      "path": "/capabilities/weaver",
      "parentPath": "/capabilities",
      "clientRoles": [],
      "capabilities": ["agent-runtime.entitled"]
    }
  ],
  "secretRefs": [
    "secretref://weave/provider/keycloak-realm/admin-password",
    "secretref://weave/provider/keycloak-realm/matrix-mas-client-secret",
    "secretref://weave/provider/keycloak-realm/nextcloud-client-secret"
  ],
  "rawSecretsIncluded": false
}
