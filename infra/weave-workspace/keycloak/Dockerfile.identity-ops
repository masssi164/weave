ARG WEAVE_UBI9_BASE=registry.access.redhat.com/ubi9@sha256:2a6bd6971e6026177b2439655282660519198870e9063c4a03a208de88be2e9e
ARG WEAVE_KEYCLOAK_BASE=quay.io/keycloak/keycloak@sha256:0f198be292568439d700cdbfb893e69a6009bb43a94a06a945b1d3d506c76b13
FROM ${WEAVE_UBI9_BASE} AS python-root
RUN mkdir -p /mnt/rootfs \
    && dnf install -y --installroot /mnt/rootfs --releasever 9 --setopt install_weak_deps=false --setopt keepcache=false python3 \
    && rm -rf /mnt/rootfs/var/cache/dnf

FROM ${WEAVE_KEYCLOAK_BASE}
ARG WEAVE_IMAGE_CREATED=unbound
ARG WEAVE_IMAGE_REVISION=unbound
ARG WEAVE_IMAGE_VERSION=unbound
ARG WEAVE_SPEC_DIGEST=unbound
ARG WEAVE_SBOM_REFERENCE=unbound
ARG WEAVE_PROVENANCE_REFERENCE=unbound

LABEL org.opencontainers.image.title="Weave Identity Ops" \
      org.opencontainers.image.description="Rootless stock-Keycloak desired-state reconciliation through official kcadm.sh operations" \
      org.opencontainers.image.source="https://github.com/masssi164/weave" \
      org.opencontainers.image.revision="${WEAVE_IMAGE_REVISION}" \
      org.opencontainers.image.version="${WEAVE_IMAGE_VERSION}" \
      org.opencontainers.image.created="${WEAVE_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="Weave" \
      com.massimotter.weave.spec-digest="${WEAVE_SPEC_DIGEST}" \
      com.massimotter.weave.module="identity-ops" \
      com.massimotter.weave.runtime-user="1000:1000" \
      com.massimotter.weave.dependency-platform="keycloak-26.7-kcadm-python3" \
      com.massimotter.weave.sbom-reference="${WEAVE_SBOM_REFERENCE}" \
      com.massimotter.weave.provenance-reference="${WEAVE_PROVENANCE_REFERENCE}"

COPY --from=python-root /mnt/rootfs /
COPY --chown=1000:1000 identity_ops.py /opt/weave/identity_ops.py
COPY --chown=1000:1000 identity_admin_key_init.py /opt/weave/identity_admin_key_init.py
USER 1000:1000
ENTRYPOINT ["python3", "/opt/weave/identity_ops.py"]
