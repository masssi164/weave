{
  "schema": "weave-mcp-workload-contract-v2",
  "status": "guarded-workload-boundary-active",
  "placement": {
    "contractArea": "infra/weave-workspace",
    "runtimeModule": "weave-mcp-server",
    "runtimeInfrastructureModule": "infra/weave-workspace/compose.yaml#mcp",
    "implementation": "Spring AI 2.0 Streamable HTTP with current server-owned workload/member binding, constrained token exchange, and backend authorization",
    "retiredRuntime": "infra/weave-mcp Python and FastMCP gateway",
    "architecturePrinciple": "MCP is a workload-only Weaver boundary; humans never access MCP"
  },
  "authorityBoundary": {
    "productAuthority": "weave-backend",
    "mcpRole": "curated workload-only Files and Calendar projection through the generated Weave User API",
    "canonicalApiRemainsAuthoritative": true,
    "runtimeDirectProviderAccessAllowed": false,
    "memberMayConfigureProvidersThroughMcp": false,
    "humanAccessAllowed": false,
    "unboundServiceAccountAccessAllowed": false
  },
  "globalControls": {
    "defaultExposeTools": false,
    "staticCatalogDoesNotAuthorizeInvocation": true,
    "denyUnknownTools": true,
    "supportSafeOutputsOnly": true,
    "secretRefOnly": true,
    "credentialRefOnly": true,
    "rawProviderInternalsReturned": false,
    "rawProviderPayloadsReturned": false,
    "credentialBearingUrlsReturned": false,
    "auditRequiredForEveryToolCall": true,
    "serverApprovalOracleAllowed": false,
    "serverOwnedBindingRequired": true,
    "currentMemberAuthorizationRequired": true,
    "currentToolGrantRequired": true,
    "incomingBearerRelayAllowed": false,
    "exchangedScopeMayExceedAdmittedWorkloadScope": false,
    "humanTokensForbidden": true,
    "genericServiceAccountsForbidden": true
  },
  "activeRuntimeEvidence": {
    "transport": "stateful-streamable-http-workload-active",
    "endpoint": "/mcp",
    "oidcGatekeeper": "spring-security-oauth2-resource-server",
    "accessTokenType": "at+jwt",
    "protectedResourceMetadata": "/.well-known/oauth-protected-resource/mcp",
    "clientCredentialsExtension": "io.modelcontextprotocol/oauth-client-credentials",
    "backendContext": "downscoped-token-exchange-and-current-member-binding",
    "tools": [
      "files.search",
      "calendar.agenda"
    ],
    "resources": [
      "weave://files/{canonicalFileId}"
    ],
    "prompts": [],
    "filesDataPlane": {
      "standard": "generated Weave User Files OpenAPI",
      "facade": "/api/files/items",
      "canonicalIdProperty": "fileId",
      "toolSpecificBackendEndpoint": false
    },
    "calendarDataPlane": {
      "standard": "generated Weave User Calendar OpenAPI",
      "facade": "/api/calendar/calendars",
      "canonicalIdProperty": "calendarId",
      "toolSpecificBackendEndpoint": false,
      "previewMaterializationAllowed": false
    },
    "pythonFastMcpRemoved": true,
    "handwrittenJsonRpcRemoved": true,
    "enabled": true,
    "security": "rfc9068-exact-audience-scope-and-current-member-resource-authorization"
  }
}
