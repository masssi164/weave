{
  "schemaVersion": "weave.infra.fresh-start-targets.v1",
  "environment": "persistent-dogfood",
  "stack": "weave",
  "targets": [
    {"kind": "container", "name": "weave-dogfood-backend", "component": "server", "dataClass": "runtime-ephemeral"},
    {"kind": "container", "name": "weave-dogfood-db", "component": "postgres", "dataClass": "runtime-ephemeral"},
    {"kind": "container", "name": "weave-dogfood-keycloak", "component": "identity", "dataClass": "runtime-ephemeral"},
    {"kind": "container", "name": "weave-dogfood-mailpit", "component": "mail", "dataClass": "activation-sensitive"},
    {"kind": "container", "name": "weave-dogfood-mcp-server", "component": "mcp", "dataClass": "runtime-ephemeral"},
    {"kind": "container", "name": "weave-dogfood-proxy", "component": "gateway", "dataClass": "runtime-ephemeral"},
    {"kind": "network", "name": "weave_dogfood_network", "component": "network", "dataClass": "connectivity"},
    {"kind": "volume", "name": "weave_dogfood_caddy_config", "component": "gateway", "dataClass": "configuration-sensitive"},
    {"kind": "volume", "name": "weave_dogfood_caddy_data", "component": "gateway", "dataClass": "tls-sensitive"},
    {"kind": "volume", "name": "weave_dogfood_db_data", "component": "postgres", "dataClass": "database-sensitive"},
    {"kind": "volume", "name": "weave_dogfood_keycloak_data", "component": "identity", "dataClass": "identity-sensitive"},
    {"kind": "volume", "name": "weave_dogfood_mailpit_data", "component": "mail", "dataClass": "activation-sensitive"},
    {"kind": "volume", "name": "weave_dogfood_native_files_data", "component": "files-native", "dataClass": "collaboration-sensitive"}
  ],
  "exclusions": []
}
