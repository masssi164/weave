{
  "schema": "weave-weaver-runtime-lifecycle-contract-v2",
  "status": "guarded-control-plane",
  "runtimeProfileInput": {
    "source": "signed-RuntimeProfile-v2",
    "requiredVerification": [
      "flattenedJwsEdDsa",
      "rfc8785Payload",
      "issuer",
      "organizationRef",
      "personRef",
      "cellRef",
      "workloadClientId",
      "runtimeProfileHash",
      "expiresAt",
      "revocationGeneration",
      "currentCellBinding"
    ],
    "forbiddenMaterial": [
      "rawProviderSecrets",
      "oauthAccessTokens",
      "oauthRefreshTokens",
      "credentialBearingProviderUrls",
      "rawProviderPayloads"
    ]
  },
  "identity": {
    "authority": "keycloak",
    "clientPerCell": true,
    "clientIdTemplate": "weaver-cell-{cellId}",
    "grant": "client_credentials",
    "tokenMaxTtlSeconds": 60,
    "subjectBinding": "immutable-keycloak-service-account-subject",
    "authorizedPartyEqualsClientId": true,
    "soleRealmRole": "weaver-runtime",
    "clientRolesAllowed": false,
    "profileFetch": {
      "audience": "https://api.weave.test/api/v1/agent-runtime",
      "soleScope": "agent-runtime.profile.read"
    },
    "mcp": {
      "audience": "https://api.weave.test/mcp",
      "requiredBaseScope": "mcp.tools",
      "domainScopesFromCurrentRuntimeProfile": true,
      "edgeClientId": "weave-mcp-server",
      "accessTokenType": "at+jwt",
      "clientCredentialsExtension": "io.modelcontextprotocol/oauth-client-credentials",
      "backendTokenExchange": "standard-token-exchange-v2-downscoped",
      "incomingBearerRelayAllowed": false
    },
    "humanOrGenericServiceAccess": "deny"
  },
  "containerBinding": {
    "activeContainerPerTrustBoundary": 1,
    "trustBoundaryKeys": [
      "organizationRef",
      "personRef",
      "cellRef",
      "runtimeProfileHash",
      "revocationGeneration"
    ],
    "supportSafeContainerNameTemplate": "weaver-{cellRef}",
    "disallowHumanOrProviderIdentifiersInRuntimeRefs": true
  },
  "filesystem": {
    "zeroDurableCellLocalBytes": true,
    "readOnlyRootFilesystem": true,
    "durableCellVolumesAllowed": false,
    "implicitHostMounts": false,
    "ephemeralWritableMounts": [
      "tmpfs-runtime",
      "tmpfs-materialization-staging",
      "tmpfs-cache"
    ],
    "portableWorkspace": {
      "authority": "webdav",
      "manifest": "signed-WorkspaceManifest",
      "materialization": "validated-ephemeral-snapshot"
    },
    "forbiddenMounts": [
      "/var/run/docker.sock",
      "hostSshAgent",
      "hostKeychain",
      "operatorHome",
      "rawOpenClawDashboard",
      "durableStateDir",
      "durableWorkspaceDir",
      "durableAgentDir"
    ]
  },
  "externalRuntimeState": {
    "authority": "RuntimeStateStore",
    "cellLocalCopy": "ephemeral-only",
    "webDavStorageAllowed": false,
    "dogfoodAdapter": "postgresql-client-encrypted-generations",
    "generationCipher": "AES-256-GCM",
    "dataKeyWrapping": "AES-KWP-mounted-file-key",
    "authenticatedContext": [
      "organizationRef",
      "personRef",
      "cellRef",
      "storeRef",
      "generationRef",
      "generation",
      "runtimeProfileHash"
    ],
    "commit": "compare-and-swap",
    "fileKeyClaimMaturity": "Guarded",
    "productionRequirement": "external-kms-or-secret-manager-adapter"
  },
  "resources": {
    "memoryLimitRequired": true,
    "cpuLimitRequired": true,
    "processLimitRequired": true,
    "ephemeralDiskQuotaRequired": true,
    "ephemeralCleanupRequired": true
  },
  "network": {
    "defaultEgress": "deny",
    "allowedInternalTargets": [
      "weave-api-internal",
      "weave-mcp-gateway-internal",
      "allowed-channel-proxy"
    ],
    "forbiddenTargets": [
      "public-internet",
      "provider-api-direct",
      "cloud-metadata-service",
      "host-network",
      "cross-cell-runtime-network"
    ]
  },
  "lifecycle": {
    "states": [
      "ABSENT",
      "PROVISIONING",
      "STOPPED",
      "STARTING",
      "MATERIALIZING",
      "READY",
      "BUSY",
      "SYNCING",
      "DEGRADED",
      "SUSPENDED",
      "REVOKING",
      "DELETING",
      "DELETED"
    ],
    "eventProcessingStates": [
      "READY",
      "BUSY"
    ],
    "revocationAction": "revoke-credential-stop-cell-deny-profile-and-tools",
    "deleteAction": "confirmed-delete-runtime-state-identity-credential-and-ephemeral-material",
    "cellDeletionDeletesWebDav": false,
    "confirmedRuntimeStateDeletionDeletesExternalRuntimeState": true,
    "runtimeStateDeletionConfirmation": "DELETE_RUNTIME_STATE_ONLY"
  },
  "restore": {
    "consistencySet": [
      "keycloak-data",
      "agent-runtime-control-store",
      "runtime-profile-signing-secret-root",
      "runtime-state-wrapping-secret-root",
      "workload-credential-secret-refs"
    ],
    "normalStartupMayGenerateMissingKeys": false,
    "readinessBlockedUntilReconciled": true
  },
  "supportBundle": {
    "allowedEvidence": [
      "supportSafeCellRef",
      "runtimeProfileHash",
      "lifecycleState",
      "reconciliationStatus",
      "runtimeStateGenerationCount",
      "policyDecisionRef",
      "auditEventRef"
    ],
    "redactOrOmit": [
      "prompts",
      "rawProviderPayloads",
      "oauthAccessTokens",
      "oauthRefreshTokens",
      "cookies",
      "privateKeys",
      "keyReferences",
      "credentialReferences",
      "credentialBearingUrls",
      "SecretRefValues",
      "runtimeTokens",
      "memberNames",
      "emails",
      "roomIds",
      "eventIds",
      "filenames",
      "directProviderIdentifiers"
    ]
  }
}
