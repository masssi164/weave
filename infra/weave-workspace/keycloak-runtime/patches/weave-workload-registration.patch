+    /**
+     * Runs on the raw OIDC metadata before Keycloak can derive a pairwise-subject mapper.
+     */
+    public static void validateOidcMetadata(
+            OIDCClientRepresentation representation, String targetClientId)
+            throws ClientPolicyException {
+        String requested = targetClientId == null
+                ? representation.getClientName()
+                : targetClientId;
+        if (requested != null && requested.startsWith("weaver-cell-")) {
+            if (!isWorkloadClient(requested)
+                    || !"private_key_jwt".equals(
+                            representation.getTokenEndpointAuthMethod())
+                    || !Algorithm.PS256.equals(
+                            representation.getTokenEndpointAuthSigningAlg())
+                    || !exactSet(
+                            representation.getGrantTypes(), Set.of("client_credentials"))
+                    || hasValues(representation.getResponseTypes())
+                    || hasValues(representation.getRedirectUris())
+                    || representation.getApplicationType() != null
+                    || hasText(representation.getClientSecret())
+                    || hasText(representation.getClientUri())
+                    || hasText(representation.getLogoUri())
+                    || hasValues(representation.getContacts())
+                    || hasText(representation.getTosUri())
+                    || hasText(representation.getPolicyUri())
+                    || hasText(representation.getJwksUri())
+                    || hasText(representation.getInitiateLoginUri())
+                    || hasValues(representation.getRequestUris())
+                    || hasValues(representation.getPostLogoutRedirectUris())
+                    || hasText(representation.getBackchannelLogoutUri())
+                    || hasText(representation.getFrontChannelLogoutUri())
+                    || !Boolean.FALSE.equals(
+                            representation.getBackchannelLogoutSessionRequired())
+                    || !Boolean.FALSE.equals(
+                            representation.getBackchannelLogoutRevokeOfflineTokens())
+                    || !Boolean.FALSE.equals(
+                            representation.getFrontchannelLogoutSessionRequired())
+                    || representation.getSectorIdentifierUri() != null
+                    || (representation.getSubjectType() != null
+                            && !"public".equals(representation.getSubjectType()))
+                    || representation.getScope() == null
+                    || !exactSet(
+                            List.of(representation.getScope().split(" ", -1)),
+                            OPTIONAL_SCOPES)) {
+                throw invalid(INVALID_DETAIL);
+            }
+            // The exact raw OIDC scope set is validated above. Remove it before conversion so
+            // Keycloak's legacy authenticated-registration allowlist cannot widen or reject the
+            // server-owned final assignment performed by the post-create event.
+            representation.setScope(null);
+        }
+    }
