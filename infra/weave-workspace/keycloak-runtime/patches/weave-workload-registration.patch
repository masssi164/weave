@@ -0,0 +1,175 @@
+package org.keycloak.services.clientregistration.oidc;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.core.MultivaluedHashMap;
+import jakarta.ws.rs.core.Response;
+import java.io.ByteArrayInputStream;
+import java.lang.reflect.Method;
+import java.util.Base64;
+import org.junit.jupiter.api.Test;
+import org.keycloak.services.ErrorResponseException;
+import org.keycloak.services.clientpolicy.ClientPolicyException;
+import org.keycloak.services.clientpolicy.executor.WeaveWorkloadClientRegistrationExecutor;
+
+class WeaveRegistrationHandoffTest {
+
+    private static final String CAPABILITY =
+            Base64.getUrlEncoder().withoutPadding().encodeToString(new byte[32]);
+    private static final String STATE = "sha256:" + "a".repeat(64);
+
+    @Test
+    void acceptsOnlyTheClosedCanonicalHeaderShape() throws Exception {
+        MultivaluedHashMap<String, String> headers = headers();
+
+        var parsed = WeaveWorkloadClientRegistrationExecutor.parseHandoffHeaders(
+                headers, "create");
+        assertEquals("create", parsed.operation());
+        assertTrue(parsed.capabilityDigest().matches("sha256:[a-f0-9]{64}"));
+
+        MultivaluedHashMap<String, String> duplicated = headers();
+        duplicated.add(
+                WeaveWorkloadClientRegistrationExecutor.HANDOFF_HEADER, CAPABILITY);
+        assertThrows(
+                ClientPolicyException.class,
+                () -> WeaveWorkloadClientRegistrationExecutor.parseHandoffHeaders(
+                        duplicated, "create"));
+        MultivaluedHashMap<String, String> padded = headers();
+        padded.putSingle(
+                WeaveWorkloadClientRegistrationExecutor.HANDOFF_HEADER,
+                CAPABILITY + "=");
+        assertThrows(
+                ClientPolicyException.class,
+                () -> WeaveWorkloadClientRegistrationExecutor.parseHandoffHeaders(
+                        padded, "create"));
+    }
+
+    @Test
+    void rejectsNonCanonicalCapabilityStateAndOperationHeaders() {
+        for (String capability : new String[] {
+            CAPABILITY.substring(1),
+            CAPABILITY + "A",
+            CAPABILITY.substring(0, 42) + "+",
+            CAPABILITY.substring(0, 42) + "/",
+            " " + CAPABILITY,
+            CAPABILITY + " ",
+            CAPABILITY.substring(0, 21) + "," + CAPABILITY.substring(22),
+            "A".repeat(129)
+        }) {
+            MultivaluedHashMap<String, String> invalid = headers();
+            invalid.putSingle(
+                    WeaveWorkloadClientRegistrationExecutor.HANDOFF_HEADER,
+                    capability);
+            assertInvalid(invalid, "create");
+        }
+
+        for (String state : new String[] {
+            "sha256:" + "A".repeat(64),
+            "sha256:" + "a".repeat(63),
+            "sha256:" + "a".repeat(65),
+            " " + STATE,
+            STATE + " "
+        }) {
+            MultivaluedHashMap<String, String> invalid = headers();
+            invalid.putSingle(
+                    WeaveWorkloadClientRegistrationExecutor.HANDOFF_STATE_HEADER,
+                    state);
+            assertInvalid(invalid, "create");
+        }
+
+        for (String operation : new String[] {
+            "CREATE", "delete", "create ", " create", ""
+        }) {
+            MultivaluedHashMap<String, String> invalid = headers();
+            invalid.putSingle(
+                    WeaveWorkloadClientRegistrationExecutor.HANDOFF_OPERATION_HEADER,
+                    operation);
+            assertInvalid(invalid, "create");
+        }
+        assertInvalid(headers(), "rotate");
+    }
+
+    @Test
+    void rejectsMissingAndDuplicatedHandoffHeaders() {
+        for (String header : new String[] {
+            WeaveWorkloadClientRegistrationExecutor.HANDOFF_HEADER,
+            WeaveWorkloadClientRegistrationExecutor.HANDOFF_STATE_HEADER,
+            WeaveWorkloadClientRegistrationExecutor.HANDOFF_OPERATION_HEADER
+        }) {
+            MultivaluedHashMap<String, String> missing = headers();
+            missing.remove(header);
+            assertInvalid(missing, "create");
+
+            MultivaluedHashMap<String, String> duplicated = headers();
+            duplicated.add(header, duplicated.getFirst(header));
+            assertInvalid(duplicated, "create");
+        }
+    }
+
+    @Test
+    void exposesOnlyPostSubresourcesAndRejectsBodies() throws Exception {
+        Method recover = OIDCClientRegistrationProvider.class.getMethod(
+                "recoverRegistrationHandoff", String.class, java.io.InputStream.class);
+        Method finalize = OIDCClientRegistrationProvider.class.getMethod(
+                "finalizeRegistrationHandoff", String.class, java.io.InputStream.class);
+
+        assertTrue(recover.isAnnotationPresent(POST.class));
+        assertEquals(
+                "{clientId}/weave-registration-handoff/recover",
+                recover.getAnnotation(Path.class).value());
+        assertTrue(finalize.isAnnotationPresent(POST.class));
+        assertEquals(
+                "{clientId}/weave-registration-handoff/finalize",
+                finalize.getAnnotation(Path.class).value());
+        assertThrows(
+                ErrorResponseException.class,
+                () -> OIDCClientRegistrationProvider.requireEmptyBody(
+                        new ByteArrayInputStream(new byte[] {1})));
+    }
+
+    @Test
+    void responsesAreExplicitlyNonCacheable() {
+        try (Response response = OIDCClientRegistrationProvider
+                .noStore(Response.noContent())
+                .build()) {
+            assertEquals("no-store", response.getHeaderString("Cache-Control"));
+            assertEquals("no-cache", response.getHeaderString("Pragma"));
+        }
+        try (Response response = invokeProtocolError().getResponse()) {
+            assertEquals("no-store", response.getHeaderString("Cache-Control"));
+            assertEquals("no-cache", response.getHeaderString("Pragma"));
+            assertEquals(400, response.getStatus());
+        }
+    }
+
+    private static ErrorResponseException invokeProtocolError() {
+        return assertThrows(
+                ErrorResponseException.class,
+                () -> OIDCClientRegistrationProvider.requireEmptyBody(
+                        new ByteArrayInputStream(new byte[] {1})));
+    }
+
+    private static void assertInvalid(
+            MultivaluedHashMap<String, String> headers, String operation) {
+        assertThrows(
+                ClientPolicyException.class,
+                () -> WeaveWorkloadClientRegistrationExecutor.parseHandoffHeaders(
+                        headers, operation));
+    }
+
+    private static MultivaluedHashMap<String, String> headers() {
+        MultivaluedHashMap<String, String> headers = new MultivaluedHashMap<>();
+        headers.putSingle(
+                WeaveWorkloadClientRegistrationExecutor.HANDOFF_HEADER, CAPABILITY);
+        headers.putSingle(
+                WeaveWorkloadClientRegistrationExecutor.HANDOFF_STATE_HEADER, STATE);
+        headers.putSingle(
+                WeaveWorkloadClientRegistrationExecutor.HANDOFF_OPERATION_HEADER,
+                "create");
+        return headers;
+    }
+}
