+    private void enforceFinalState(ClientModel client) throws ClientPolicyException {
+        RealmModel realm = client.getRealm();
+        ClientScopeModel defaultScope = findScope(realm, DEFAULT_SCOPE);
+        List<ClientScopeModel> optionalScopes = OPTIONAL_SCOPES.stream()
+                .map(scope -> findScope(realm, scope))
+                .toList();
+        if (defaultScope == null || optionalScopes.contains(null)) {
+            throw invalid(INVALID_FINAL_STATE_DETAIL);
+        }
+
+        new HashSet<>(client.getClientScopes(true).values()).forEach(client::removeClientScope);
+        new HashSet<>(client.getClientScopes(false).values()).forEach(client::removeClientScope);
+        client.addClientScope(defaultScope, true);
+        optionalScopes.forEach(scope -> client.addClientScope(scope, false));
+        client.getProtocolMappersStream().toList().forEach(client::removeProtocolMapper);
+        client.setSecret(null);
+        client.removeAttribute(ClientSecretConstants.CLIENT_SECRET_CREATION_TIME);
+        client.removeAttribute(ClientSecretConstants.CLIENT_SECRET_EXPIRATION);
+        new HashSet<>(client.getAttributes().keySet()).stream()
+                .filter(attribute -> !ALLOWED_ATTRIBUTES.contains(attribute))
+                .forEach(client::removeAttribute);
+        FIXED_ATTRIBUTES.forEach(client::setAttribute);
+
+        UserModel serviceAccount = session.users().getServiceAccount(client);
+        RoleModel workloadRole = realm.getRole(WORKLOAD_ROLE);
+        if (serviceAccount == null || workloadRole == null) {
+            throw invalid(INVALID_FINAL_STATE_DETAIL);
+        }
+        serviceAccount.getRoleMappingsStream().toList().forEach(serviceAccount::deleteRoleMapping);
+        serviceAccount.grantRole(workloadRole);
+        validateFinalState(client);
+    }
+
+    private static ClientScopeModel findScope(RealmModel realm, String name) {
+        return realm.getClientScopesStream()
+                .filter(scope -> name.equals(scope.getName()))
+                .findFirst()
+                .orElse(null);
+    }
+
+    private void validateFinalState(ClientModel client) throws ClientPolicyException {
+        Map<String, String> attributes = client.getAttributes();
+        UserModel serviceAccount = session.users().getServiceAccount(client);
+        if (serviceAccount == null) {
+            throw invalid(INVALID_DETAIL);
+        }
+        Set<RoleIdentity> directRoles = serviceAccount.getRoleMappingsStream()
+                .map(WeaveWorkloadClientRegistrationExecutor::roleIdentity)
+                .collect(Collectors.toUnmodifiableSet());
+        Set<RoleIdentity> effectiveRoles =
+                RoleUtils.getDeepUserRoleMappings(serviceAccount).stream()
+                .map(WeaveWorkloadClientRegistrationExecutor::roleIdentity)
+                .collect(Collectors.toUnmodifiableSet());
+
+        if (!isWorkloadClient(client.getClientId())
+                || !OIDCLoginProtocol.LOGIN_PROTOCOL.equals(client.getProtocol())
+                || !JWTClientAuthenticator.PROVIDER_ID.equals(client.getClientAuthenticatorType())
+                || !client.isServiceAccountsEnabled()
+                || client.isPublicClient()
+                || client.isBearerOnly()
+                || client.isStandardFlowEnabled()
+                || client.isImplicitFlowEnabled()
+                || client.isDirectAccessGrantsEnabled()
+                || client.isFullScopeAllowed()
+                || hasText(client.getSecret())
+                || hasValues(client.getRedirectUris())
+                || hasValues(client.getWebOrigins())
+                || hasText(client.getRootUrl())
+                || hasText(client.getBaseUrl())
+                || hasText(client.getManagementUrl())
+                || client.getProtocolMappersStream().findAny().isPresent()) {
+            throw invalid(INVALID_FINAL_POSTURE_DETAIL);
+        }
+        if (!Set.of(DEFAULT_SCOPE).equals(client.getClientScopes(true).keySet())
+                || !OPTIONAL_SCOPES.equals(client.getClientScopes(false).keySet())) {
+            throw invalid(INVALID_FINAL_SCOPES_DETAIL);
+        }
+        Set<String> expectedAttributeKeys = new HashSet<>(ALLOWED_ATTRIBUTES);
+        boolean hasAnyHandoff =
+                attributes.keySet().stream().anyMatch(IN_FLIGHT_ATTRIBUTES::contains);
+        if (hasAnyHandoff) {
+            expectedAttributeKeys.addAll(IN_FLIGHT_ATTRIBUTES);
+        }
+        if (!expectedAttributeKeys.equals(attributes.keySet())) {
+            throw invalid(INVALID_FINAL_ATTRIBUTE_SET_DETAIL);
+        }
+        if (!Boolean.TRUE.toString().equals(attributes.get(OIDCConfigAttributes.USE_JWKS_STRING))
+                || !Boolean.FALSE.toString().equals(
+                        attributes.get(OIDCConfigAttributes.USE_JWKS_URL))) {
+            throw invalid(INVALID_FINAL_KEY_SOURCE_DETAIL);
+        }
+        if (!Algorithm.PS256.equals(
+                attributes.get(OIDCConfigAttributes.TOKEN_ENDPOINT_AUTH_SIGNING_ALG))) {
+            throw invalid(INVALID_FINAL_AUTH_DETAIL);
+        }
+        if (!Boolean.FALSE.toString().equals(attributes.get(USE_REFRESH_TOKENS))) {
+            throw invalid(INVALID_FINAL_REFRESH_DETAIL);
+        }
+        if (!Boolean.FALSE.toString().equals(
+                attributes.get(BACKCHANNEL_LOGOUT_SESSION_REQUIRED))) {
+            throw invalid(INVALID_FINAL_BACKCHANNEL_SESSION_DETAIL);
+        }
+        if (!Boolean.FALSE.toString().equals(
+                attributes.get(BACKCHANNEL_LOGOUT_REVOKE_OFFLINE_TOKENS))) {
+            throw invalid(INVALID_FINAL_BACKCHANNEL_REVOKE_DETAIL);
+        }
+        if (!Boolean.FALSE.toString().equals(
+                attributes.get(FRONTCHANNEL_LOGOUT_SESSION_REQUIRED))) {
+            throw invalid(INVALID_FINAL_FRONTCHANNEL_SESSION_DETAIL);
+        }
+        validateExactRoles(client.getRealm().getId(), directRoles, effectiveRoles);
+    }
+
+    static void validateExactRoles(
+            String realmId,
+            Set<RoleIdentity> directRoles,
+            Set<RoleIdentity> effectiveRoles)
+            throws ClientPolicyException {
+        RoleIdentity expected =
+                new RoleIdentity("realm", realmId, WORKLOAD_ROLE);
+        if (!Set.of(expected).equals(directRoles)
+                || !Set.of(expected).equals(effectiveRoles)) {
+            throw invalid(INVALID_FINAL_ROLES_DETAIL);
+        }
+    }
+
+    static RoleIdentity roleIdentity(RoleModel role) {
+        return new RoleIdentity(
+                role.isClientRole() ? "client" : "realm",
+                role.getContainerId(),
+                role.getName());
+    }
+
+    private static void rejectAdminBypass(ClientCRUDContext context)
+            throws ClientPolicyException {
+        ClientRepresentation proposed = context.getProposedClientRepresentation();
+        ClientModel target = context.getTargetClient();
+        ClientModel authenticated = context.getAuthenticatedClient();
+        if ((authenticated != null
+                        && RUNTIME_ADMIN_CLIENT_ID.equals(authenticated.getClientId()))
+                || (proposed != null
+                        && (isWorkloadClient(proposed.getClientId())
+                                || isWorkloadClient(proposed.getName())))
+                || (target != null && isWorkloadClient(target.getClientId()))) {
+            throw invalid(INVALID_DETAIL);
+        }
+    }
+
+    private static void requireRuntimeAdmin(ClientCRUDContext context)
+            throws ClientPolicyException {
+        ClientModel authenticated = context.getAuthenticatedClient();
+        JsonWebToken token = context.getToken();
+        if (authenticated == null
+                || !RUNTIME_ADMIN_CLIENT_ID.equals(authenticated.getClientId())
+                || context.getAuthenticatedUser() == null
+                || !exactRuntimeAdminToken(token, authenticated.getRealm())) {
+            throw invalid(INVALID_DETAIL);
+        }
+    }
+
+    public static boolean exactRuntimeAdminToken(
+            JsonWebToken token, RealmModel realm) {
+        String realmManagement = realm.getName().equals(org.keycloak.Config.getAdminRealm())
+                ? realm.getMasterAdminClient().getClientId()
+                : org.keycloak.models.Constants.REALM_MANAGEMENT_CLIENT_ID;
+        return exactRuntimeAdminToken(token, realmManagement);
+    }
+
+    public static boolean exactRuntimeAdminToken(
+            JsonWebToken token, String realmManagementClientId) {
+        if (!(token instanceof org.keycloak.representations.AccessToken accessToken)
+                || !RUNTIME_ADMIN_CLIENT_ID.equals(accessToken.getIssuedFor())
+                || accessToken.getRealmAccess() != null
+                        && accessToken.getRealmAccess().getRoles() != null
+                        && !accessToken.getRealmAccess().getRoles().isEmpty()) {
+            return false;
+        }
+        Map<String, org.keycloak.representations.AccessToken.Access> resourceAccess =
+                accessToken.getResourceAccess();
+        if (resourceAccess == null
+                || !Set.of(realmManagementClientId).equals(resourceAccess.keySet())) {
+            return false;
+        }
+        Set<String> roles = resourceAccess.get(realmManagementClientId).getRoles();
+        return Set.of(org.keycloak.models.AdminRoles.CREATE_CLIENT)
+                .equals(Objects.requireNonNullElse(roles, Set.of()));
+    }
+
+    public static boolean exactRuntimeAdminClient(ClientModel client) {
+        if (client == null) {
+            return false;
+        }
+        Map<String, String> attributes = client.getAttributes();
+        return RUNTIME_ADMIN_CLIENT_ID.equals(client.getClientId())
+                && client.isEnabled()
+                && OIDCLoginProtocol.LOGIN_PROTOCOL.equals(client.getProtocol())
+                && JWTClientAuthenticator.PROVIDER_ID.equals(
+                        client.getClientAuthenticatorType())
+                && client.isServiceAccountsEnabled()
+                && !client.isPublicClient()
+                && !client.isBearerOnly()
+                && !client.isStandardFlowEnabled()
+                && !client.isImplicitFlowEnabled()
+                && !client.isDirectAccessGrantsEnabled()
+                && !client.isFullScopeAllowed()
+                && !hasText(client.getSecret())
+                && !hasValues(client.getRedirectUris())
+                && !hasValues(client.getWebOrigins())
+                && !hasText(client.getRootUrl())
+                && !hasText(client.getBaseUrl())
+                && !hasText(client.getManagementUrl())
+                && client.getProtocolMappersStream().findAny().isEmpty()
+                && Algorithm.PS256.equals(
+                        attributes.get(OIDCConfigAttributes.TOKEN_ENDPOINT_AUTH_SIGNING_ALG))
+                && Boolean.TRUE.toString().equals(
+                        attributes.get(OIDCConfigAttributes.USE_JWKS_STRING))
+                && Boolean.FALSE.toString().equals(
+                        attributes.get(OIDCConfigAttributes.USE_JWKS_URL))
+                && hasText(attributes.get(OIDCConfigAttributes.JWKS_STRING));
+    }
+
+    private static String updateOperation(
+            ClientRepresentation proposed, ClientModel current)
+            throws ClientPolicyException {
+        boolean currentRevoked = hasRevocationOnlyJwk(
+                current.getAttribute(OIDCConfigAttributes.JWKS_STRING));
+        String proposedJwks = proposed == null || proposed.getAttributes() == null
+                ? null
+                : proposed.getAttributes().get(OIDCConfigAttributes.JWKS_STRING);
+        boolean proposedRevoked = hasRevocationOnlyJwk(proposedJwks);
+        if (proposedRevoked) {
+            return "disable";
+        }
+        return currentRevoked ? "reenable" : "rotate";
+    }
+
+    private static boolean hasRevocationOnlyJwk(String encoded)
+            throws ClientPolicyException {
+        try {
+            JsonNode root = JsonSerialization.mapper.readTree(encoded);
+            JsonNode keys = root == null ? null : root.get("keys");
+            return keys instanceof ArrayNode array
+                    && array.size() == 1
+                    && array.get(0).path("kid").asText("").startsWith("revoked_");
+        } catch (IOException | RuntimeException failure) {
+            throw invalid(INVALID_CREDENTIAL_ATTRIBUTES_DETAIL);
+        }
+    }
+
+    public static HandoffHeaders parseHandoffHeaders(
+            MultivaluedMap<String, String> headers, String expectedOperation)
+            throws ClientPolicyException {
+        String capability = exactHeader(headers, HANDOFF_HEADER);
+        String state = exactHeader(headers, HANDOFF_STATE_HEADER);
+        String operation = exactHeader(headers, HANDOFF_OPERATION_HEADER);
+        if (!HANDOFF_CAPABILITY.matcher(capability).matches()
+                || !SHA256.matcher(state).matches()
+                || !HANDOFF_OPERATIONS.contains(operation)
+                || expectedOperation != null && !expectedOperation.equals(operation)) {
+            throw invalidHandoff();
+        }
+        byte[] decoded;
+        try {
+            decoded = Base64.getUrlDecoder().decode(capability);
+        } catch (IllegalArgumentException failure) {
+            throw invalidHandoff();
+        }
+        if (decoded.length != 32
+                || !capability.equals(
+                        Base64.getUrlEncoder().withoutPadding().encodeToString(decoded))) {
+            throw invalidHandoff();
+        }
+        return new HandoffHeaders(
+                capability,
+                sha256(decoded),
+                state,
+                operation);
+    }
+
+    private static String exactHeader(
+            MultivaluedMap<String, String> headers, String name)
+            throws ClientPolicyException {
+        List<String> values = headers == null ? null : headers.get(name);
+        if (values == null
+                || values.size() != 1
+                || values.get(0) == null
+                || values.get(0).isBlank()
+                || values.get(0).length() > 128
+                || !values.get(0).equals(values.get(0).strip())
+                || values.get(0).contains(",")) {
+            throw invalidHandoff();
+        }
+        return values.get(0);
+    }
+
+    private HandoffHeaders requireHandoffHeaders(String operation)
+            throws ClientPolicyException {
+        if (handoffHeaders == null
+                || operation != null && !operation.equals(handoffHeaders.operation())) {
+            throw invalidHandoff();
+        }
+        return handoffHeaders;
+    }
+
+    private void commitHandoff(ClientModel client, HandoffHeaders headers)
+            throws ClientPolicyException {
+        client.setAttribute(HANDOFF_DIGEST_ATTRIBUTE, headers.capabilityDigest());
+        client.setAttribute(HANDOFF_STATE_ATTRIBUTE, headers.stateDigest());
+        client.setAttribute(HANDOFF_OPERATION_ATTRIBUTE, headers.operation());
+        String observed = canonicalStateDigest(client, headers.operation());
+        if (!MessageDigest.isEqual(
+                observed.getBytes(StandardCharsets.US_ASCII),
+                headers.stateDigest().getBytes(StandardCharsets.US_ASCII))) {
+            throw new ClientPolicyException(
+                    OAuthErrorException.INVALID_CLIENT_METADATA,
+                    "Weave workload registration state does not match the prepared handoff.",
+                    Response.Status.CONFLICT);
+        }
+        validateFinalState(client);
+    }
+
+    public String canonicalStateDigest(ClientModel client, String operation)
+            throws ClientPolicyException {
+        validateFinalState(client);
+        try {
+            ObjectNode root = JsonSerialization.mapper.createObjectNode();
+            root.put("clientId", client.getClientId());
+            root.set("defaultClientScopes", sortedStrings(
+                    client.getClientScopes(true).keySet()));
+            ArrayNode roles = root.putArray("effectiveRoles");
+            UserModel serviceAccount = session.users().getServiceAccount(client);
+            RoleUtils.getDeepUserRoleMappings(serviceAccount).stream()
+                    .map(role -> role.isClientRole()
+                            ? roleIdentity(role)
+                            : new RoleIdentity("realm", client.getRealm().getName(), role.getName()))
+                    .sorted(Comparator.comparing(RoleIdentity::kind)
+                            .thenComparing(RoleIdentity::containerId)
+                            .thenComparing(RoleIdentity::name))
+                    .forEach(role -> {
+                        ObjectNode value = JsonSerialization.mapper.createObjectNode();
+                        value.put("containerId", role.containerId());
+                        value.put("kind", role.kind());
+                        value.put("name", role.name());
+                        roles.add(value);
+                    });
+            ObjectNode attributes = root.putObject("fixedAttributes");
+            new TreeMap<>(FIXED_ATTRIBUTES).forEach(attributes::put);
+            ObjectNode flows = root.putObject("flows");
+            flows.put("authorizationCode", client.isStandardFlowEnabled());
+            flows.put("ciba", Boolean.parseBoolean(
+                    client.getAttribute("oidc.ciba.grant.enabled")));
+            flows.put("device", Boolean.parseBoolean(
+                    client.getAttribute("oauth2.device.authorization.grant.enabled")));
+            flows.put("directAccessGrant", client.isDirectAccessGrantsEnabled());
+            flows.put("implicit", client.isImplicitFlowEnabled());
+            flows.put("jwtAuthorizationGrant", Boolean.parseBoolean(
+                    client.getAttribute(OIDCConfigAttributes.JWT_AUTHORIZATION_GRANT_ENABLED)));
+            flows.put("serviceAccounts", client.isServiceAccountsEnabled());
+            flows.put("standardTokenExchange", Boolean.parseBoolean(
+                    client.getAttribute(OIDCConfigAttributes.STANDARD_TOKEN_EXCHANGE_ENABLED)));
+            flows.put("uma", false);
+            root.put("operation", operation);
+            root.set("optionalClientScopes", sortedStrings(
+                    client.getClientScopes(false).keySet()));
+            root.set("protocolMappers", JsonSerialization.mapper.createArrayNode());
+            root.set("publicJwks", normalizedJwks(
+                    client.getAttribute(OIDCConfigAttributes.JWKS_STRING)));
+            ObjectNode token = root.putObject("tokenEndpointAuthentication");
+            token.put("algorithm", Algorithm.PS256);
+            token.put("method", JWTClientAuthenticator.PROVIDER_ID);
+            root.set("uris", JsonSerialization.mapper.createArrayNode());
+            root.set("webOrigins", JsonSerialization.mapper.createArrayNode());
+            return sha256(JsonSerialization.writeValueAsBytes(root));
+        } catch (IOException | RuntimeException failure) {
+            throw invalid(INVALID_FINAL_STATE_DETAIL);
+        }
+    }
+
+    public HandoffState requireRecoverableHandoff(
+            ClientModel client, HandoffHeaders headers)
+            throws ClientPolicyException {
+        if (client == null || headers == null) {
+            throw handoffDenied(Response.Status.NOT_FOUND);
+        }
+        validateFinalState(client);
+        if (!constantTimeEquals(
+                        client.getAttribute(HANDOFF_DIGEST_ATTRIBUTE),
+                        headers.capabilityDigest())
+                || !constantTimeEquals(
+                        client.getAttribute(HANDOFF_STATE_ATTRIBUTE),
+                        headers.stateDigest())
+                || !constantTimeEquals(
+                        client.getAttribute(HANDOFF_OPERATION_ATTRIBUTE),
+                        headers.operation())) {
+            throw handoffDenied(Response.Status.FORBIDDEN);
+        }
+        String observed = canonicalStateDigest(client, headers.operation());
+        if (!constantTimeEquals(observed, headers.stateDigest())) {
+            throw new ClientPolicyException(
+                    "registration_handoff_state_mismatch",
+                    "The registration handoff state does not match.",
+                    Response.Status.CONFLICT);
+        }
+        UserModel serviceAccount = session.users().getServiceAccount(client);
+        if (serviceAccount == null || serviceAccount.getId() == null) {
+            throw new ClientPolicyException(
+                    "registration_handoff_state_mismatch",
+                    "The registration handoff state does not match.",
+                    Response.Status.CONFLICT);
+        }
+        return new HandoffState(
+                observed,
+                sha256(serviceAccount.getId().getBytes(StandardCharsets.UTF_8)));
+    }
+
+    public void finalizeHandoff(ClientModel client, HandoffHeaders headers)
+            throws ClientPolicyException {
+        requireRecoverableHandoff(client, headers);
+        client.removeAttribute(HANDOFF_DIGEST_ATTRIBUTE);
+        client.removeAttribute(HANDOFF_STATE_ATTRIBUTE);
+        client.removeAttribute(HANDOFF_OPERATION_ATTRIBUTE);
+        validateFinalState(client);
+    }
+
+    private static boolean constantTimeEquals(String left, String right) {
+        return left != null
+                && right != null
+                && MessageDigest.isEqual(
+                        left.getBytes(StandardCharsets.US_ASCII),
+                        right.getBytes(StandardCharsets.US_ASCII));
+    }
+
+    private static ClientPolicyException handoffDenied(Response.Status status) {
+        return new ClientPolicyException(
+                "registration_handoff_denied",
+                "The registration handoff is not permitted.",
+                status);
+    }
+
+    private static ArrayNode sortedStrings(Collection<String> values) {
+        ArrayNode array = JsonSerialization.mapper.createArrayNode();
+        values.stream().sorted().forEach(array::add);
+        return array;
+    }
+
+    private static ObjectNode normalizedJwks(String encoded)
+            throws IOException, ClientPolicyException {
+        JsonNode parsed = JsonSerialization.mapper.readTree(encoded);
+        JsonNode keys = parsed == null ? null : parsed.get("keys");
+        if (!(keys instanceof ArrayNode input) || input.isEmpty()) {
+            throw invalid(INVALID_CREDENTIAL_ATTRIBUTES_DETAIL);
+        }
+        List<JsonNode> ordered = new ArrayList<>();
+        input.forEach(ordered::add);
+        ordered.sort(Comparator.comparing(key -> key.path("kid").asText()));
+        ObjectNode result = JsonSerialization.mapper.createObjectNode();
+        ArrayNode normalized = result.putArray("keys");
+        for (JsonNode key : ordered) {
+            ObjectNode value = JsonSerialization.mapper.createObjectNode();
+            for (String field : List.of("alg", "e", "kid", "kty", "n", "use")) {
+                JsonNode item = key.get(field);
+                if (item == null || !item.isTextual() || item.asText().isBlank()) {
+                    throw invalid(INVALID_CREDENTIAL_ATTRIBUTES_DETAIL);
+                }
+                value.put(field, item.asText());
+            }
+            normalized.add(value);
+        }
+        return result;
+    }
+
+    private static String sha256(byte[] value) {
+        try {
+            return "sha256:" + HexFormat.of().formatHex(
+                    MessageDigest.getInstance("SHA-256").digest(value));
+        } catch (NoSuchAlgorithmException impossible) {
+            throw new IllegalStateException(impossible);
+        }
+    }
+
+    private static ClientPolicyException invalidHandoff() {
+        return new ClientPolicyException(
+                "invalid_registration_handoff",
+                "The registration handoff is invalid.",
+                Response.Status.BAD_REQUEST);
+    }
+
+    private static void requireBoundRegistrationAccessToken(
+            ClientCRUDContext context, ClientModel target) throws ClientPolicyException {
+        JsonWebToken token = context.getToken();
+        if (token == null
+                || !ClientRegistrationTokenUtils.TYPE_REGISTRATION_ACCESS_TOKEN.equals(
+                        token.getType())
+                || !Objects.equals(target.getRegistrationToken(), token.getId())) {
+            throw invalid(CROSS_CELL_DETAIL);
+        }
+    }
+
+    private static boolean isAdminContext(ClientPolicyContext context) {
+        return context instanceof AdminClientRegisterContext
+                || context instanceof AdminClientRegisteredContext
+                || context instanceof AdminClientUpdateContext
+                || context instanceof AdminClientUpdatedContext
+                || context instanceof AdminClientViewContext
+                || context instanceof AdminClientUnregisterContext;
+    }
+
+    static boolean isWorkloadClient(String clientId) {
+        return clientId != null && CLIENT_ID_PATTERN.matcher(clientId).matches();
+    }
+
+    private static boolean hasText(String value) {
+        return value != null && !value.isBlank();
+    }
+
+    private static boolean hasValues(Iterable<?> values) {
+        return values != null && values.iterator().hasNext();
+    }
+
+    private static boolean exactSet(List<String> values, Set<String> expected) {
+        return values != null
+                && expected.equals(new HashSet<>(values))
+                && values.size() == expected.size();
+    }
+
+    private static ClientPolicyException invalid(String detail) {
+        return new ClientPolicyException(
+                OAuthErrorException.INVALID_CLIENT_METADATA,
+                detail,
+                Response.Status.BAD_REQUEST);
+    }
+
+    public record HandoffHeaders(
+            String capability,
+            String capabilityDigest,
+            String stateDigest,
+            String operation) {}
+
+    public record RoleIdentity(String kind, String containerId, String name) {}
+
+    public record HandoffState(String stateDigest, String subjectDigest) {}
+}
