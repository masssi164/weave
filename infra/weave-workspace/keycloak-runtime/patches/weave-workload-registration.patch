+package org.keycloak.services.clientregistration;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.Map;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+import org.keycloak.representations.AccessToken;
+import org.keycloak.services.clientpolicy.executor.WeaveWorkloadClientRegistrationExecutor;
+
+class WeaveClientRegistrationAuthTest {
+
+    @Test
+    void acceptsOnlyTheExactRuntimeAdminCreateClientProjection() {
+        AccessToken token = new AccessToken().issuedFor("weave-agent-runtime-admin");
+        token.setResourceAccess(Map.of(
+                "realm-management",
+                new AccessToken.Access().roles(Set.of("create-client"))));
+
+        assertTrue(WeaveWorkloadClientRegistrationExecutor.exactRuntimeAdminToken(
+                token, "realm-management"));
+
+        token.setResourceAccess(Map.of(
+                "realm-management",
+                new AccessToken.Access().roles(
+                        Set.of("create-client", "manage-clients"))));
+        assertFalse(WeaveWorkloadClientRegistrationExecutor.exactRuntimeAdminToken(
+                token, "realm-management"));
+
+        token.setResourceAccess(Map.of(
+                "realm-management",
+                new AccessToken.Access().roles(Set.of("create-client")),
+                "account",
+                new AccessToken.Access().roles(Set.of("view-profile"))));
+        assertFalse(WeaveWorkloadClientRegistrationExecutor.exactRuntimeAdminToken(
+                token, "realm-management"));
+    }
+}
diff --git a/services/src/test/java/org/keycloak/services/clientregistration/oidc/WeaveRegistrationHandoffTest.java b/services/src/test/java/org/keycloak/services/clientregistration/oidc/WeaveRegistrationHandoffTest.java
