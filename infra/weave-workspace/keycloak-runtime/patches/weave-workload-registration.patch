+        // The reviewed contract is intentionally fixed and has no realm-specific knobs.
+    }
+
+    @Override
+    public void postInit(KeycloakSessionFactory factory) {
+        // No global state is retained.
+    }
+
+    @Override
+    public void close() {
+        // No resources are retained.
+    }
+
+    @Override
+    public String getId() {
+        return WeaveWorkloadClientRegistrationExecutor.PROVIDER_ID;
+    }
+
+    @Override
+    public String getHelpText() {
+        return "Enforces the Weave per-Cell OIDC Dynamic Client Registration contract.";
+    }
+
+    @Override
+    public List<ProviderConfigProperty> getConfigProperties() {
+        return List.of();
+    }
+}
