+package org.keycloak.services.clientpolicy.executor;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import java.util.List;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+import org.keycloak.representations.idm.ClientRepresentation;
+import org.keycloak.representations.oidc.OIDCClientRepresentation;
+import org.keycloak.services.clientpolicy.ClientPolicyException;
+
+class WeaveWorkloadClientRegistrationExecutorTest {
+
+    private static final String CLIENT_ID = "weaver-cell-example_01";
+    private static final String APPROVED_SCOPES =
+            "agent-runtime.profile.read mcp.tools files.read";
+
+    @Test
+    void acceptsAndNormalizesTheExactOidcMetadataContract() {
+        OIDCClientRepresentation representation = representation(CLIENT_ID, APPROVED_SCOPES);
+
+        assertDoesNotThrow(() ->
+                WeaveWorkloadClientRegistrationExecutor.prepareOidcRegistrationMetadata(
+                        representation));
+
+        assertNull(representation.getScope());
+        assertEquals(CLIENT_ID, representation.getClientId());
+        representation.setScope("unapproved.scope");
+        WeaveWorkloadClientRegistrationExecutor.normalizeOidcResponseMetadata(representation);
+        assertEquals("agent-runtime.profile.read files.read mcp.tools", representation.getScope());
+    }
+
+    @Test
+    void rejectsInvalidNamespaceBeforeDescriptionConversion() {
+        OIDCClientRepresentation representation =
+                representation("weaver-cell-invalid!", APPROVED_SCOPES);
+
+        assertThrows(
+                ClientPolicyException.class,
+                () -> WeaveWorkloadClientRegistrationExecutor.validateOidcMetadata(
+                        representation, null));
+    }
+
+    @Test
+    void rejectsUnapprovedScopesBeforeDescriptionConversion() {
+        OIDCClientRepresentation representation =
+                representation(CLIENT_ID, APPROVED_SCOPES + " realm-management");
+
+        assertThrows(
+                ClientPolicyException.class,
+                () -> WeaveWorkloadClientRegistrationExecutor.validateOidcMetadata(
+                        representation, null));
+    }
+
+    @Test
+    void rejectsWrongRawAuthenticationMethodBeforeDescriptionConversion() {
+        OIDCClientRepresentation representation =
+                representation(CLIENT_ID, APPROVED_SCOPES);
+        representation.setTokenEndpointAuthMethod("client_secret_basic");
+
+        assertThrows(
+                ClientPolicyException.class,
+                () -> WeaveWorkloadClientRegistrationExecutor.validateOidcMetadata(
+                        representation, null));
+    }
+
+    @Test
+    void rejectsHumanLoginFlowBeforeDescriptionConversion() {
+        OIDCClientRepresentation representation =
+                representation(CLIENT_ID, APPROVED_SCOPES);
+        representation.setGrantTypes(List.of("authorization_code"));
+        representation.setResponseTypes(List.of("code"));
+        representation.setRedirectUris(List.of("https://forbidden.invalid/callback"));
+
+        assertThrows(
+                ClientPolicyException.class,
+                () -> WeaveWorkloadClientRegistrationExecutor.validateOidcMetadata(
+                        representation, null));
+    }
+
+    @Test
+    void rejectsProviderUrlBeforeDescriptionConversion() {
+        OIDCClientRepresentation representation =
+                representation(CLIENT_ID, APPROVED_SCOPES);
+        representation.setClientUri("https://forbidden.invalid");
+
+        assertThrows(
+                ClientPolicyException.class,
+                () -> WeaveWorkloadClientRegistrationExecutor.validateOidcMetadata(
+                        representation, null));
+    }
+
+    @Test
+    void rejectsInvalidNamespaceAtTheClientPolicyBoundary() {
+        ClientRepresentation representation = new ClientRepresentation();
+        representation.setName("weaver-cell-invalid!");
+
+        assertThrows(
+                ClientPolicyException.class,
+                () -> WeaveWorkloadClientRegistrationExecutor.prepareRegistration(
+                        representation));
+    }
+
+    @Test
+    void rejectsAnInjectedExtraEffectiveServiceAccountRole() {
+        assertThrows(
+                ClientPolicyException.class,
+                () -> WeaveWorkloadClientRegistrationExecutor.validateExactRoles(
+                        "weave",
+                        Set.of(new WeaveWorkloadClientRegistrationExecutor.RoleIdentity(
+                                "realm", "weave", "weaver-runtime")),
+                        Set.of(
+                                new WeaveWorkloadClientRegistrationExecutor.RoleIdentity(
+                                        "realm", "weave", "weaver-runtime"),
+                                new WeaveWorkloadClientRegistrationExecutor.RoleIdentity(
+                                        "client", "realm-management", "manage-clients"))));
+    }
+
+    @Test
+    void rejectsAClientRoleWithTheApprovedRealmRoleName() {
+        assertThrows(
+                ClientPolicyException.class,
+                () -> WeaveWorkloadClientRegistrationExecutor.validateExactRoles(
+                        "weave",
+                        Set.of(new WeaveWorkloadClientRegistrationExecutor.RoleIdentity(
+                                "client", "workload-client", "weaver-runtime")),
+                        Set.of(new WeaveWorkloadClientRegistrationExecutor.RoleIdentity(
+                                "client", "workload-client", "weaver-runtime"))));
+    }
+
+    private static OIDCClientRepresentation representation(
+            String clientName, String scopes) {
+        OIDCClientRepresentation representation = new OIDCClientRepresentation();
+        representation.setClientName(clientName);
+        representation.setScope(scopes);
+        representation.setSubjectType("public");
+        representation.setTokenEndpointAuthMethod("private_key_jwt");
+        representation.setTokenEndpointAuthSigningAlg("PS256");
+        representation.setGrantTypes(List.of("client_credentials"));
+        representation.setResponseTypes(List.of());
+        representation.setRedirectUris(List.of());
+        representation.setBackchannelLogoutSessionRequired(false);
+        representation.setBackchannelLogoutRevokeOfflineTokens(false);
+        representation.setFrontchannelLogoutSessionRequired(false);
+        return representation;
+    }
+}
