# Docker Compose reads public deployment inputs only. Copy the matching file in
# environments/ and keep credential values in the private WEAVE_SECRET_ROOT.
#
#   ./compose.sh dev config
#   ./compose.sh dev up
#
# Never put passwords, assertions, bearer tokens, private keys, SMTP
# credentials, or provider credentials in an env file.
WEAVE_ENVIRONMENT=dev
WEAVE_COMPOSE_PROJECT=weave-dev
WEAVE_RESOURCE_PREFIX=weave
WEAVE_DOCKER_NETWORK=weave_network
WEAVE_GENERATED_ROOT=./.generated/dev
WEAVE_SECRET_ROOT=./.generated/dev/secrets
WEAVE_TLS_ROOT=./.generated/dev/tls
