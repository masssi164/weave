+    /// Sign a Weave device-continuity challenge with this installed Matrix
+    /// device's Ed25519 key. The private key remains inside the crypto store.
+    pub async fn sign_device_continuity_challenge(&self, challenge: &str) -> Result<String> {
+        let machine = self.client.olm_machine().await;
+        let machine = machine.as_ref().ok_or(Error::NoOlmMachine)?;
+        let signatures = machine.sign(challenge).await?;
+        let key_id = DeviceKeyId::from_parts(DeviceKeyAlgorithm::Ed25519, machine.device_id());
+        let signature = signatures
+            .get_signature(machine.user_id(), &key_id)
+            .ok_or(Error::NoOlmMachine)?;
+        Ok(signature.to_base64())
+    }
